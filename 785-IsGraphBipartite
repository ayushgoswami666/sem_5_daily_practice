class Solution {
    public boolean isBipartite(int[][] graph) {
        Queue<Bipartite_pair> q = new LinkedList<>();
        HashMap<Integer,Integer> visited = new HashMap<>();
        for(int key =0;key<graph.length;key++){
            if(visited.containsKey(key)){
                continue;
            }
            q.add(new Bipartite_pair(key,0));
            while(!q.isEmpty()){
            Bipartite_pair rv = q.poll();
            if(visited.containsKey(rv.vtx)){
                if(visited.get(rv.vtx)!=rv.dis){
                    return false;
                }
                continue;

            }
            visited.put(rv.vtx,rv.dis);
            for(int nbrs:graph[rv.vtx]){
                if(!visited.containsKey(nbrs)){
                    q.add(new Bipartite_pair(nbrs,rv.dis+1));
                }
            }
            }

        }
        return true;
        
        
    }
    class Bipartite_pair{
        int vtx;
        int dis;
        public Bipartite_pair(int vtx,int dis){
            this.vtx = vtx;
            this.dis = dis;
        }
    }
}